# ==============================
# PYTHON CACHE
# ==============================
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ==============================
# VIRTUAL ENVIRONMENTS
# ==============================
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# ==============================
# DJANGO & MIGRATIONS
# ==============================
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
staticfiles/
backend/staticfiles/
media/

# Ignore migration files, but keep __init__.py
*/migrations/*.py
!*/migrations/__init__.py

# ==============================
# ENVIRONMENT VARIABLES
# ==============================
.env
.env.*
!.env.example

# ==============================
# FIREBASE CREDENTIALS
# ==============================
secrets/
firebase-service-account.json

# ==============================
# FRONTEND (Entire Folder)
# ==============================
frontend/

# ==============================
# TESTING / COVERAGE
# ==============================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ==============================
# TYPE CHECKING / LINTING
# ==============================
.mypy_cache/
.dmypy.json
.pyre/
.ruff_cache/

# ==============================
# JUPYTER
# ==============================
.ipynb_checkpoints/

# ==============================
# IDE / EDITORS
# ==============================
.vscode/
.idea/
*.sublime-workspace

# ==============================
# OS FILES
# ==============================
.DS_Store
Thumbs.db
desktop.ini

# ==============================
# BUILD FILES
# ==============================
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/
